# ==============================================================================
# 安全扫描检查项总表 — WSTG 骨架
# ==============================================================================
# 用途     扫描时逐项执行；报告中逐项报备（含 N/A 及不适用原因）
# 基线     OWASP WSTG master（13 分类 / 116 测试项），已逐项核对官方仓库
# 视角     一律公网视角，不以本机 / 内网网络状态为准
# 版本     v1.0 | 2026-09-20
# 配套     checklist-extras.yaml（场景扩展项）
# ==============================================================================

- meta:
    version: v1.0
    baseline: OWASP WSTG master (13 categories / 116 test items)
    baseline_source: https://github.com/OWASP/wstg/tree/master/document/4-Web_Application_Security_Testing
    updated: "2026-09-20"
    scope: 公网视角（内网扫描需单独立项）
    total_items: 117
    note: 含 1 项占位（WSTG-WASM-00），该分类官方基线尚未发布测试项；官方实际测试项为 116
    report_rule: 每一项均须在报告中出现，结论为 通过 / 不通过 / N/A(附原因)

# ------------------------------------------------------------------------------
# 适用条件枚举（app 字段取值，用于自动判定 N/A）
# ------------------------------------------------------------------------------
- applicability:
    always:        目标存在即适用，无需前置条件
    has_login:     目标存在登录 / 认证流程
    has_account:   目标存在账号体系（注册 / 找回 / 资料修改）
    has_admin:     目标存在管理后台或管理接口
    has_api:       目标存在 API 接口（REST / RPC）
    has_graphql:   目标使用 GraphQL
    has_input:     目标存在用户可控输入的参数
    has_upload:    目标存在文件上传功能
    has_download:  目标存在文件下载 / 导出功能
    has_payment:   目标涉及支付 / 交易 / 资金
    has_oauth:     目标使用 OAuth / OIDC / 第三方登录
    has_session:   目标使用会话（Cookie 或 Token）
    has_client:    目标存在浏览器端渲染
    has_websocket: 目标使用 WebSocket
    has_component: 目标使用第三方组件 / 框架
    has_storage:   目标使用云存储（OSS / COS / S3 / OBS）
    has_cloud:     目标部署在云环境
    has_cicd:      存在公网可达的构建 / 部署产物或流水线配置
    has_ai:        目标存在 AI / LLM 接口

# ------------------------------------------------------------------------------
# 定级规则（level 字段的判定基准，与规格第 5 章一致）
# ------------------------------------------------------------------------------
- severity_model:
    levels: [严重, 高危, 中危, 低危, 信息]
    严重: 实测可直接获得系统控制权或全量数据
    高危: 实测可获取有效业务数据 / 越权权限 / 篡改数据并生效
    中危: 路径可达且有技术证据但未实证危害，或危害仅限本人账号
    低危: 仅攻击面暴露，无直接危害路径
    信息: 配置优化建议
    downgrade_factors: [需已认证身份, 需特定角色, 需用户交互, 需罕见环境, 版本区间无法确认]
    upgrade_factors: [无需认证, 可跨用户跨租户, 可批量利用, 触及生产数据]
    evidence_cap:
      A: 确证可达 — 可定级至严重 / 高危
      B: 路由存在无鉴权 — 上限中危
      C: 无法确证 — 不进入漏洞清单，列入「待确认」章节

# ==============================================================================
# 01 信息收集  Information Gathering
# ==============================================================================
- category: INFO
  name: 信息收集
  wstg_dir: 01-Information_Gathering
  items:
    - id: WSTG-INFO-01
      name: 搜索引擎信息泄露侦察
      app: always
      detect: 搜索引擎 dork 查询目标域名下的敏感文件与泄露路径
      verify: 人工确认（命中结果即证据）
      level: 命中真实敏感文件 → 高危；仅目录结构暴露 → 低危
      compliance: 等保2.0 数据保密性 / ISO 27001 A.8.9

    - id: WSTG-INFO-02
      name: Web 服务器指纹识别
      app: always
      detect: 响应头 Server / X-Powered-By 及错误页特征
      verify: 脚本比对 Banner 指纹库
      level: 版本号泄露 → 低危；版本对应已知高危 CVE → 升级至该 CVE 定级
      compliance: ISO 27001 A.8.8 / 等保2.0 入侵防范

    - id: WSTG-INFO-03
      name: Web 服务器元文件信息泄露审查
      app: always
      detect: robots.txt / sitemap.xml / .well-known / security.txt 等元文件
      verify: 人工确认元文件暴露的路径是否可访问
      level: 暴露敏感路径且可访问 → 中危；仅列常规路径 → 信息
      compliance: 等保2.0 数据保密性

    - id: WSTG-INFO-04
      name: 攻击面识别
      app: always
      detect: 子域枚举、端口探测、服务识别、CDN 与源站判定
      verify: 公网测绘平台交叉确认（Shodan / Censys / FOFA）
      level: 非预期暴露服务 → 中危；核心服务（数据库 / Redis）公网可达 → 高危
      compliance: ISO 27001 A.8.20 / 等保2.0 边界访问控制

    - id: WSTG-INFO-05
      name: 页面内容信息泄露审查
      app: always
      detect: HTML 注释、JS 源码、Source Map、API 地址与密钥残留
      verify: grep 提取敏感模式 + 人工确认可用性
      level: 泄露可控凭据（AK/SK / Token）→ 高危；仅内网地址 / 注释 → 低危
      compliance: 等保2.0 数据保密性 / PCI-DSS 3.x

    - id: WSTG-INFO-06
      name: 应用入口点识别
      app: always
      detect: URL 参数、表单字段、Header、Cookie 中的全部输入点枚举
      verify: 脚本汇总输入点清单，供后续注入类检查复用
      level: 纯清单型，不单独定级（供 P2-P5 引用）
      compliance: ISO 27001 A.8.25

    - id: WSTG-INFO-07
      name: 应用执行路径映射
      app: always
      detect: 爬取 + 目录爆破 + JS 路由提取，构建完整路径树
      verify: 脚本产出路径树，标注可达状态
      level: 纯清单型，不单独定级（供后续阶段复用）
      compliance: ISO 27001 A.8.25

    - id: WSTG-INFO-08
      name: Web 应用框架指纹识别
      app: always
      detect: 框架特征（Cookie 名 / 错误页 / 静态资源路径 / 特有端点）
      verify: 脚本匹配框架指纹库
      level: 框架版本对应已知 RCE → 高危；仅指纹暴露 → 低危
      compliance: ISO 27001 A.8.8

    - id: WSTG-INFO-09
      name: Web 应用指纹识别
      app: always
      detect: 应用自身版本号、Build 信息、CHANGELOG、actuator 端点
      verify: 脚本 + 人工确认
      level: 暴露内部构建信息 → 低危；配合已知 CVE → 升级定级
      compliance: ISO 27001 A.8.8

    - id: WSTG-INFO-10
      name: 应用架构映射
      app: always
      detect: 前后端分离结构、网关、微服务路由、第三方依赖外链
      verify: 人工分析 + 域名 / IP 归属核对
      level: 纯分析型，不单独定级（用于确定后续测试范围）
      compliance: ISO 27001 A.8.20

# ==============================================================================
# 02 配置与部署管理  Configuration and Deployment Management
# ==============================================================================
- category: CONF
  name: 配置与部署管理
  wstg_dir: 02-Configuration_and_Deployment_Management
  items:
    - id: WSTG-CONF-01
      name: 网络基础设施配置
      app: always
      detect: 反向代理 / 负载均衡 / WAF 配置暴露与防护绕过
      verify: 交叉探测 + WAF 拦截特征识别
      level: WAF 可被轻易绕过 → 中危；核心防护缺失 → 高危
      compliance: 等保2.0 边界访问控制 / ISO 27001 A.8.20

    - id: WSTG-CONF-02
      name: 应用平台配置
      app: always
      detect: 默认配置、调试模式、示例应用、管理端点暴露
      verify: 逐项访问确认（含伪路径对照，防 404 误判）
      level: 调试端点可执行代码 / 读取配置 → 严重；仅页面暴露 → 中危
      compliance: 等保2.0 入侵防范 / ISO 27001 A.8.9

    - id: WSTG-CONF-03
      name: 敏感信息文件扩展名处理
      app: always
      detect: .bak / .old / .swp / .zip / .tar.gz 等备份扩展名
      verify: 逐项请求 + 内容确认是否为真实备份（非空壳）
      level: 备份文件含源码或配置 → 高危；空文件 / 占位页 → 低危
      compliance: 等保2.0 数据保密性 / ISO 27001 A.8.9

    - id: WSTG-CONF-04
      name: 旧备份与未引用文件审查
      app: always
      detect: 归档目录、历史版本、未被引用的静态文件
      verify: 逐项确认可访问性与内容有效性
      level: 含有效数据 → 高危；仅历史静态资源 → 低危
      compliance: 等保2.0 数据保密性

    - id: WSTG-CONF-05
      name: 基础设施与应用管理接口枚举
      app: always
      detect: Jenkins / Swagger / Knife4j / Adminer / phpMyAdmin / actuator
      verify: 访问确认 + 是否需认证 + 能否实操
      level: 管理接口无鉴权且可操作 → 严重；文档暴露可复现接口结构 → 高危；仅页面存在 → 中危
      compliance: 等保2.0 访问控制 / ISO 27001 A.8.3

    - id: WSTG-CONF-06
      name: HTTP 方法测试
      app: always
      detect: PUT / DELETE / TRACE / OPTIONS / WebDAV 等非预期方法
      verify: 逐方法发送 + 确认是否实际生效（含伪路径对照）
      level: PUT 写文件并生效 → 严重；方法开启但无效果 → 中危
      compliance: 等保2.0 入侵防范

    - id: WSTG-CONF-07
      name: HTTP 严格传输安全（HSTS）
      app: always
      detect: Strict-Transport-Security 头缺失 / max-age 过短 / 未含 includeSubDomains
      verify: 响应头检查 + 公网侧复测
      level: 完全缺失 → 低危；配置不当 → 信息
      compliance: 等保2.0 通信加密 / PCI-DSS 4.1

    - id: WSTG-CONF-08
      name: RIA 跨域策略
      app: always
      detect: crossdomain.xml / clientaccesspolicy.xml 通配符授权
      verify: 访问确认文件内容
      level: 通配符授权且资产敏感 → 中危；现代应用通常 N/A
      compliance: ISO 27001 A.8.26

    - id: WSTG-CONF-09
      name: 文件权限
      app: always
      detect: 敏感文件可访问性、目录列表开启、配置文件可读
      verify: 逐项访问 + 内容有效性确认
      level: 可读配置文件含凭据 → 高危；目录列表 → 低危
      compliance: 等保2.0 访问控制 / ISO 27001 A.8.3

    - id: WSTG-CONF-10
      name: 子域接管
      app: always
      detect: CNAME 指向已失效的第三方服务（GitHub Pages / Heroku / S3 等）
      verify: dig CNAME + 第三方平台指纹确认 + 不实际接管
      level: 确证可接管 → 高危（可劫持业务域名）；仅悬空记录 → 中危
      compliance: ISO 27001 A.8.20 / 供应链安全

    - id: WSTG-CONF-11
      name: 云存储配置
      app: has_storage
      detect: OSS / COS / S3 / OBS 桶的 ListObjects 与匿名读写权限
      verify: 匿名请求确认；仅验证权限，不下载业务数据
      level: 可匿名列出并读取业务文件 → 严重；仅可列目录 → 高危
      compliance: 等保2.0 数据保密性 / ISO 27001 A.8.3

    - id: WSTG-CONF-12
      name: 内容安全策略（CSP）
      app: has_client
      detect: CSP 头缺失、unsafe-inline / unsafe-eval、通配符来源
      verify: 响应头检查 + 结合 XSS 发现评估实际影响
      level: 缺失且存在 XSS → 中危；仅缺失无 XSS → 低危
      compliance: ISO 27001 A.8.26

    - id: WSTG-CONF-13
      name: 路径混淆
      app: always
      detect: 用 // 、/./ 、/%2e/ 、大小写变体、分号截断绕过访问控制
      verify: 对受保护路径做变体请求 + 伪路径对照
      level: 确证绕过访问控制 → 高危；仅路由差异 → 中危
      compliance: 等保2.0 访问控制 / ISO 27001 A.8.3

    - id: WSTG-CONF-14
      name: 其他 HTTP 安全头配置错误
      app: always
      detect: X-Content-Type-Options / X-Frame-Options / Referrer-Policy / Permissions-Policy
      verify: 响应头逐项检查
      level: 缺失 → 低危（与其他漏洞叠加时升级）
      compliance: ISO 27001 A.8.26

    - id: WSTG-CONF-15
      name: 功能开关安全绕过
      app: always
      detect: 通过参数 / Header / 客户端存储篡改功能开关状态
      verify: 篡改开关值 + 确认真实功能是否被启用
      level: 确证开启未授权功能 → 高危；仅客户端显示变化 → 低危
      compliance: 等保2.0 访问控制

# ==============================================================================
# 03 身份管理  Identity Management
# ==============================================================================
- category: IDNT
  name: 身份管理
  wstg_dir: 03-Identity_Management
  items:
    - id: WSTG-IDNT-01
      name: 角色定义
      app: has_account
      detect: 角色划分与权限边界是否清晰，是否存在越界角色
      verify: 多账号矩阵对比
      level: 角色可自行声明 / 越界 → 高危；边界模糊 → 中危
      compliance: 等保2.0 访问控制 / ISO 27001 A.8.2

    - id: WSTG-IDNT-02
      name: 用户注册流程
      app: has_account
      detect: 注册可否绕过校验、批量注册、伪造身份信息
      verify: 受控写验证（带标记的测试账号，事后清理）
      level: 可批量注册或绕过校验 → 中危；可注册为高权限 → 严重
      compliance: 等保2.0 身份鉴别

    - id: WSTG-IDNT-03
      name: 账号开通流程
      app: has_account
      detect: 账号开通 / 分配流程是否存在越权操作
      verify: 多账号交叉测试
      level: 可为他人生成账号 / 提权 → 严重
      compliance: 等保2.0 访问控制

    - id: WSTG-IDNT-04
      name: 账号枚举与可猜测用户名
      app: has_account
      detect: 登录 / 找回 / 注册接口响应差异导致的账号枚举
      verify: 脚本比对不同账号的响应体与状态码
      level: 可枚举真实账号 → 低危（与其他漏洞叠加时升级）
      compliance: ISO 27001 A.8.5

    - id: WSTG-IDNT-05
      name: 用户名策略弱或未强制
      app: has_account
      detect: 用户名可预测 / 无唯一性校验 / 使用手机号明文
      verify: 注册流程测试
      level: 用户名可预测且可用于越权 → 中危；仅策略宽松 → 低危
      compliance: ISO 27001 A.8.5

# ==============================================================================
# 04 身份认证  Authentication
# ==============================================================================
- category: ATHN
  name: 身份认证
  wstg_dir: 04-Authentication
  items:
    - id: WSTG-ATHN-01
      name: 凭据经加密通道传输
      app: has_login
      detect: 登录请求是否走 HTTPS、是否存在 HTTP 明文提交
      verify: 抓取登录请求 + 确认协议与凭据形态
      level: 明文传输凭据 → 高危；可降级到 HTTP → 中危
      compliance: 等保2.0 通信加密 / PCI-DSS 4.1

    - id: WSTG-ATHN-02
      name: 默认凭据
      app: has_login
      detect: admin/admin、admin/123456 等默认口令
      verify: 受控尝试（限次，避免触发锁定）
      level: 默认口令可登录且具管理权限 → 严重
      compliance: 等保2.0 身份鉴别 / ISO 27001 A.8.5

    - id: WSTG-ATHN-03
      name: 锁定机制薄弱
      app: has_login
      detect: 登录失败无次数限制、无延迟、无验证码
      verify: 受控测试（5-10 次即停，避免打挂账号）
      level: 无任何限制且可爆破 → 中危；限制可绕过 → 高危
      compliance: 等保2.0 入侵防范

    - id: WSTG-ATHN-04
      name: 绕过认证方案
      app: has_login
      detect: 直接访问受保护资源、伪造 Header / Cookie 绕过登录
      verify: 无凭证请求 + 伪造头请求 + 伪路径对照
      level: 确证可绕过进入受保护功能 → 严重；仅路由可达 → 中危
      compliance: 等保2.0 身份鉴别 / PCI-DSS 8.x

    - id: WSTG-ATHN-05
      name: 易受攻击的记住密码功能
      app: has_login
      detect: 记住密码令牌可预测、无过期、可跨设备复用
      verify: 分析令牌结构 + 受控重放
      level: 令牌可伪造 / 长期有效 → 高危
      compliance: ISO 27001 A.8.5

    - id: WSTG-ATHN-06
      name: 浏览器缓存弱点
      app: has_login
      detect: 认证后页面缺 Cache-Control，可被本地缓存读取
      verify: 响应头检查
      level: 敏感页面可缓存 → 低危
      compliance: ISO 27001 A.8.24

    - id: WSTG-ATHN-07
      name: 弱认证方法
      app: has_login
      detect: 仅靠手机号 / 短信验证码 / 简单问题即可登录或改密
      verify: 流程实测
      level: 可绕过主认证 → 高危
      compliance: 等保2.0 身份鉴别

    - id: WSTG-ATHN-08
      name: 弱安全问题答案
      app: has_login
      detect: 安全问题答案可枚举、可爆破、可从公开信息推导
      verify: 流程实测
      level: 可据此接管他人账号 → 高危
      compliance: ISO 27001 A.8.5

    - id: WSTG-ATHN-09
      name: 弱密码修改与重置功能
      app: has_login
      detect: 重置令牌可预测 / 无过期 / 未绑定用户 / 可跳过验证步骤
      verify: 受控实测（仅针对自己注册的测试账号）
      level: 可重置他人密码 → 严重
      compliance: 等保2.0 身份鉴别 / ISO 27001 A.8.5

    - id: WSTG-ATHN-10
      name: 替代通道中更弱的认证
      app: has_login
      detect: 移动端 / 小程序 / 开放 API 的认证强度低于 Web 端
      verify: 多通道对比测试
      level: 可从弱通道绕过强认证 → 高危
      compliance: 等保2.0 身份鉴别

    - id: WSTG-ATHN-11
      name: 多因素认证（MFA）
      app: has_login
      detect: MFA 是否存在、可否绕过 / 降级 / 重放
      verify: 流程实测（含验证码复用与暴力尝试）
      level: MFA 可绕过 → 高危；完全缺失且涉及敏感操作 → 中危
      compliance: 等保2.0 身份鉴别 / PCI-DSS 8.x

# ==============================================================================
# 05 授权  Authorization
# ==============================================================================
- category: ATHZ
  name: 授权
  wstg_dir: 05-Authorization
  items:
    - id: WSTG-ATHZ-01
      name: 目录遍历与文件包含
      app: always
      detect: ../ 及编码变体读取任意文件；本地 / 远程文件包含
      verify: 脚本请求 + 内容对比（非空、非同文件）
      level: 读取到配置文件 / 源码含凭据 → 严重；仅可读非敏感文件 → 高危
      compliance: 等保2.0 数据保密性 / PCI-DSS 6.5.x

    - id: WSTG-ATHZ-02
      name: 绕过授权方案
      app: has_login
      detect: 用低权账号访问高权接口；篡改角色字段；路径变体绕过
      verify: 多账号矩阵交叉（低权账号请求高权接口）
      level: 确证获得高权功能并可获取数据 → 严重；仅接口返回成功无数据 → 中危
      compliance: 等保2.0 访问控制 / PCI-DSS 7.x

    - id: WSTG-ATHZ-03
      name: 权限提升
      app: has_login
      detect: 水平越权（同角色跨用户）与垂直越权（低角色→高角色）
      verify: 多账号矩阵 + 数据归属核对
      level: 实测可读取 / 修改他人数据 → 高危；仅限本人数据异常 → 中危
      compliance: 等保2.0 访问控制

    - id: WSTG-ATHZ-04
      name: 不安全的直接对象引用（IDOR）
      app: has_login
      detect: 资源 ID 可枚举、未校验归属（订单 / 用户 / 文件 / 地址）
      verify: 脚本遍历 ID（限少量）+ 确证返回他人有效数据
      level: 实测取到他人有效业务数据 → 高危；返回空 / 模板 → 低危
      compliance: PCI-DSS 6.5.3 / 等保2.0 访问控制

    - id: WSTG-ATHZ-05
      name: OAuth 弱点
      sub_items: [OAuth 授权服务器弱点, OAuth 客户端弱点]
      app: has_oauth
      detect: redirect_uri 校验不严、缺 state、缺 PKCE、令牌泄露
      verify: 流程重构实测（受控，不接管真实账号）
      level: 可劫持授权码 / 绑定攻击者账号 → 严重
      compliance: ISO 27001 A.8.5

# ==============================================================================
# 06 会话管理  Session Management
# ==============================================================================
- category: SESS
  name: 会话管理
  wstg_dir: 06-Session_Management
  items:
    - id: WSTG-SESS-01
      name: 会话管理方案
      app: has_session
      detect: 会话标识生成算法、熵值、是否可预测
      verify: 采集多个会话标识做熵分析
      level: 可预测 / 可构造 → 高危
      compliance: 等保2.0 身份鉴别 / ISO 27001 A.8.5

    - id: WSTG-SESS-02
      name: Cookie 属性
      app: has_session
      detect: HttpOnly / Secure / SameSite 缺失；作用域过宽
      verify: 响应头逐项检查
      level: 缺失且存在 XSS → 中危；仅缺失 → 低危
      compliance: ISO 27001 A.8.26

    - id: WSTG-SESS-03
      name: 会话固定
      app: has_session
      detect: 登录前后会话 ID 是否保持不变
      verify: 登录前后比对会话标识
      level: 登录后不变且可被外部设定 → 高危
      compliance: 等保2.0 身份鉴别

    - id: WSTG-SESS-04
      name: 会话变量暴露
      app: has_session
      detect: 会话信息出现在 URL / 日志 / 前端存储中
      verify: 抓包与页面检查
      level: 会话标识出现在 URL 或前端可读位置 → 中危
      compliance: ISO 27001 A.8.24

    - id: WSTG-SESS-05
      name: 跨站请求伪造（CSRF）
      app: has_session
      detect: 状态变更操作缺 Token / Token 不校验 / SameSite 缺失
      verify: 构造跨站表单实测（受控，不产生真实业务副作用）
      level: 确证可完成状态变更 → 高危；仅检测到缺失但无法实证 → 中危
      compliance: PCI-DSS 6.5.4 / 等保2.0 数据完整性

    - id: WSTG-SESS-06
      name: 登出功能
      app: has_session
      detect: 登出后会话是否立即失效、是否仅前端清除
      verify: 登出后重放旧会话标识
      level: 登出后会话仍有效 → 中危
      compliance: 等保2.0 剩余信息保护

    - id: WSTG-SESS-07
      name: 会话超时
      app: has_session
      detect: 空闲超时与绝对超时是否设置
      verify: 长时间空闲后重放
      level: 超长 / 无超时 → 低危
      compliance: 等保2.0 剩余信息保护

    - id: WSTG-SESS-08
      name: 会话困惑
      app: has_session
      detect: 多账号 / 多标签页会话相互覆盖导致权限混淆
      verify: 多会话交叉测试
      level: 可导致越权操作 → 中危
      compliance: ISO 27001 A.8.5

    - id: WSTG-SESS-09
      name: 会话劫持
      app: has_session
      detect: 会话标识可通过 XSS / 网络 / 日志途径窃取
      verify: 结合 XSS 与传输安全性综合评估
      level: 确证可窃取并复用他人会话 → 高危
      compliance: 等保2.0 身份鉴别

    - id: WSTG-SESS-10
      name: JSON Web Token（JWT）
      app: has_session
      detect: alg 可改为 none / HS256 弱密钥 / 未校验签名与过期 / kid 注入
      verify: 脚本构造篡改令牌 + 确证服务端接受
      level: 可伪造任意用户身份 → 严重
      compliance: ISO 27001 A.8.5 / 等保2.0 身份鉴别

    - id: WSTG-SESS-11
      name: 并发会话
      app: has_session
      detect: 同账号多设备并发登录是否受限 / 是否互踢
      verify: 多端登录测试
      level: 无限制且无告警 → 低危
      compliance: ISO 27001 A.8.5

# ==============================================================================
# 07 注入  Injection
# ==============================================================================
- category: INPV
  name: 注入
  wstg_dir: 07-Injection
  note: 官方仓库中 13 号存在两个文件（Buffer_Overflow 与 Format_String_Injection），此处取格式字符串注入；缓冲区溢出为遗留项，Web 场景通常 N/A
  items:
    - id: WSTG-INPV-01
      name: 反射型跨站脚本（XSS）
      app: has_input
      detect: 输入在响应中原样回显且未做上下文编码
      verify: 脚本发送标记 payload + 确认是否被编码 / 被 CSP 拦截
      level: 确证可执行脚本且无需交互 → 高危；被编码 → 排除
      compliance: PCI-DSS 6.5.2 / 等保2.0 入侵防范

    - id: WSTG-INPV-02
      name: 存储型跨站脚本（XSS）
      app: has_input
      detect: 输入被持久化并在他用户访问时执行
      verify: 受控写入标记 payload + 确认落库与回显（写入内容仅为自己可见的测试数据）
      level: 确证可影响其他用户 → 高危
      compliance: PCI-DSS 6.5.2 / 等保2.0 入侵防范

    - id: WSTG-INPV-03
      name: HTTP 动词篡改
      app: always
      detect: 用 GET / POST / PUT / PATCH / DELETE 互换绕过访问控制
      verify: 逐方法对比响应差异 + 伪路径对照
      level: 确证可执行未授权操作 → 高危；仅响应差异 → 中危
      compliance: 等保2.0 访问控制

    - id: WSTG-INPV-04
      name: HTTP 参数污染
      app: has_input
      detect: 重复参数 / 编码参数导致前后端解析不一致，绕过校验
      verify: 双参请求对比 + 确证是否绕过
      level: 确证绕过鉴权或校验 → 高危；仅解析差异 → 低危
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-05
      name: SQL 注入
      sub_items: [Oracle, MySQL, SQL Server, PostgreSQL, MS Access, NoSQL, ORM, 客户端 SQL]
      app: has_input
      detect: 布尔盲注 / 时间盲注 / 报错注入 / 联合查询 / 堆叠查询
      verify: 脚本基准对比（3 次取均）+ 时间延迟确证；OOB 外带
      level: 实证可读取业务数据 → 严重；仅可触发延迟 / 报错 → 中危
      compliance: PCI-DSS 6.5.1 / 等保2.0 入侵防范

    - id: WSTG-INPV-06
      name: LDAP 注入
      app: has_input
      detect: 登录 / 查询接口中的 LDAP 过滤器注入
      verify: 脚本注入 *)(& 等载荷 + 确认认证绕过
      level: 确证可绕过企业统一认证 → 严重
      compliance: 等保2.0 身份鉴别

    - id: WSTG-INPV-07
      name: XML 注入（XXE）
      app: has_input
      detect: XML 解析器未禁用外部实体，可读文件 / SSRF / OOB
      verify: DNS / HTTP OOB 外带确证（不读取真实业务文件）
      level: 收到 OOB 回调确证实体解析 → 高危；确认可读本地文件 → 严重
      compliance: PCI-DSS 6.5.x / 等保2.0 入侵防范

    - id: WSTG-INPV-08
      name: SSI 注入
      app: has_input
      detect: 服务端包含指令被解析执行
      verify: 注入 echo 指令 + 确认回显
      level: 确证可执行 → 严重
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-09
      name: XPath 注入
      app: has_input
      detect: XPath 查询拼接用户输入
      verify: 布尔 / 报错注入确证
      level: 确证可绕过 XML 认证 → 高危
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-10
      name: IMAP / SMTP 注入
      app: has_input
      detect: 邮件相关参数可注入额外命令
      verify: 受控测试（仅向自有测试邮箱发送）
      level: 确证可发送任意邮件 / 篡改收件人 → 中危
      compliance: ISO 27001 A.8.23

    - id: WSTG-INPV-11
      name: 代码注入
      sub_items: [本地文件包含 LFI, 远程文件包含 RFI]
      app: has_input
      detect: 参数进入 eval / include / require 等执行上下文
      verify: OOB 外带或无害计算确证（2-1=1 类）
      level: 确证可执行代码 → 严重
      compliance: PCI-DSS 6.5.5 / 等保2.0 入侵防范

    - id: WSTG-INPV-12
      name: 命令注入
      app: has_input
      detect: 系统命令拼接用户输入（含参数分隔符与编码绕过）
      verify: 时间延迟或 DNS OOB 确证（不执行实际破坏命令）
      level: 确证命令可执行 → 严重
      compliance: PCI-DSS 6.5.5 / 等保2.0 入侵防范

    - id: WSTG-INPV-13
      name: 格式字符串注入
      app: has_input
      detect: 输入进入格式化函数（%s / %n 等）
      verify: 注入格式符 + 观察异常输出或崩溃
      level: 确证可控制输出 → 高危；仅异常 → 中危
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-14
      name: 孵化漏洞
      app: has_input
      detect: 当前不可利用但具备潜在条件的功能点（预留接口 / 未完成功能）
      verify: 人工评估触发条件与前置依赖
      level: 上限中危（不得仅凭推测定高危）
      compliance: ISO 27001 A.8.8

    - id: WSTG-INPV-15
      name: HTTP 响应拆分（CRLF 注入）
      app: has_input
      detect: 输入进入响应头，可注入 \r\n 拆分响应
      verify: 确认响应头是否多出注入字段
      level: 确证可注入响应头 → 中危；可注入响应体 → 高危
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-16
      name: HTTP 请求走私
      app: always
      detect: CL / TE 头冲突或解析不一致导致请求边界混淆
      verify: 发送歧义请求 + 观察响应队列异常（受控，低频率）
      level: 确证可劫持他人请求 → 严重
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-17
      name: Host 头注入
      app: always
      detect: 应用信任 Host / X-Forwarded-Host 生成链接或路由
      verify: 篡改 Host 头 + 确认链接 / 缓存是否随之变化
      level: 确证可污染密码重置链接 → 高危；仅回显 → 中危
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-18
      name: 服务端模板注入（SSTI）
      app: has_input
      detect: 用户输入进入模板渲染上下文（Jinja2 / Twig / FreeMarker 等）
      verify: 计算载荷（7*7=49）或时间延迟确证
      level: 确证可执行表达式 → 高危；可执行系统命令 → 严重
      compliance: PCI-DSS 6.5.5 / 等保2.0 入侵防范

    - id: WSTG-INPV-19
      name: 服务端请求伪造（SSRF）
      app: has_input
      detect: URL / 回调 / webhook 参数可发起服务端请求
      verify: DNS OOB 确证 + 内网地址探测（仅确认可达性，不取数据）
      level: 确证可访问内网服务 / 云元数据 → 严重；仅外网请求 → 中危
      compliance: ISO 27001 A.8.20 / 等保2.0 边界访问控制

    - id: WSTG-INPV-20
      name: 批量赋值
      app: has_api
      detect: 请求体可附加非法字段（isAdmin / role / balance）并被服务端接收
      verify: 受控提交附加字段 + 确认是否落库生效（写入带标记测试数据）
      level: 确证可提升权限或篡改敏感字段 → 严重
      compliance: 等保2.0 数据完整性

    - id: WSTG-INPV-21
      name: CSV 注入
      app: has_download
      detect: 导出内容未转义公式符号（= / + / - / @）
      verify: 受控写入标记 payload 后导出确认
      level: 确证导出文件可触发公式执行 → 中危
      compliance: ISO 27001 A.8.26

    - id: WSTG-INPV-22
      name: 原型污染
      app: has_client
      detect: __proto__ / constructor.prototype 可污染对象原型
      verify: 脚本提交污染载荷 + 确认属性扩散
      level: 确证可提权或导致 DoS → 高危；仅属性污染 → 中危
      compliance: 等保2.0 入侵防范

    - id: WSTG-INPV-23
      name: 不安全反序列化
      app: has_input
      detect: 序列化数据（Java / PHP / Python / .NET / Node）进入反序列化路径
      verify: DNS OOB 确证（JNDI 类载荷）
      level: 确证可触发反序列化 → 严重
      compliance: PCI-DSS 6.5.5 / 等保2.0 入侵防范

# ==============================================================================
# 08 错误处理  Error Handling
# ==============================================================================
- category: ERRH
  name: 错误处理
  wstg_dir: 08-Error_Handling
  items:
    - id: WSTG-ERRH-01
      name: 错误处理不当
      app: always
      detect: 触发异常返回原始错误、数据库语句、内部路径
      verify: 构造异常输入 + 检查响应内容
      level: 泄露技术栈与内部结构 → 低危；泄露凭据 / 完整 SQL → 中危
      compliance: ISO 27001 A.8.9

    - id: WSTG-ERRH-02
      name: 堆栈跟踪泄露
      app: always
      detect: 生产环境返回完整堆栈
      verify: 构造异常 + 检查响应
      level: 泄露堆栈 → 低危（与其他漏洞叠加时升级）
      compliance: ISO 27001 A.8.9

# ==============================================================================
# 09 弱加密  Weak Cryptography
# ==============================================================================
- category: CRYP
  name: 弱加密
  wstg_dir: 09-Weak_Cryptography
  items:
    - id: WSTG-CRYP-01
      name: 弱传输层安全
      app: always
      detect: 支持 TLS 1.0 / 1.1、弱密码套件、证书问题、不支持 PFS
      verify: TLS 配置扫描 + 公网侧复核
      level: 可降级至明文 → 中危；证书无效 / 过期 → 中危；仅套件偏弱 → 低危
      compliance: PCI-DSS 4.1 / 等保2.0 通信加密

    - id: WSTG-CRYP-02
      name: Padding Oracle
      app: has_input
      detect: 加密数据解密失败的响应差异可被逐字节推断
      verify: 构造填充异常请求 + 比对响应差异（低频率）
      level: 确证可解密 / 伪造加密数据 → 严重
      compliance: ISO 27001 A.8.24

    - id: WSTG-CRYP-03
      name: 敏感信息经未加密通道发送
      app: always
      detect: 表单 / 接口存在明文 HTTP 传输敏感字段
      verify: 抓取请求 + 确认协议
      level: 明文传输凭据 / PII → 高危
      compliance: PCI-DSS 4.1 / 等保2.0 通信加密

    - id: WSTG-CRYP-04
      name: 弱加密原语
      app: always
      detect: 使用 MD5 / SHA1 / DES / RC4、ECB 模式、硬编码密钥与 IV
      verify: 分析前端加密逻辑与响应特征
      level: 前端硬编码密钥可解密凭据 → 高危；仅算法偏弱 → 低危
      compliance: ISO 27001 A.8.24

# ==============================================================================
# 10 业务逻辑  Business Logic
# ==============================================================================
- category: BUSL
  name: 业务逻辑
  wstg_dir: 10-Business_Logic
  note: 本分类为扫描器盲区主体，须人工 + 多账号矩阵验证，报告中单列专项
  items:
    - id: WSTG-BUSL-01
      name: 业务逻辑数据验证
      app: always
      detect: 业务字段可提交非法值（负数 / 超限 / 越界枚举）
      verify: 受控提交越界值 + 确认业务是否异常受理
      level: 确证可产生业务错误结果（如负数下单） → 高危
      compliance: 等保2.0 数据完整性

    - id: WSTG-BUSL-02
      name: 请求可伪造性
      app: always
      detect: 关键业务请求可由客户端任意构造，服务端缺少会话外校验
      verify: 重放 + 篡改关键参数
      level: 确证可伪造有效业务请求 → 高危
      compliance: 等保2.0 数据完整性

    - id: WSTG-BUSL-03
      name: 完整性校验
      app: always
      detect: 关键参数（金额 / 数量 / 折扣）客户端提交且服务端不重算
      verify: 篡改参数 + 确认服务端是否接受
      level: 确证可篡改金额并生效 → 严重
      compliance: PCI-DSS 6.5.x / 等保2.0 数据完整性

    - id: WSTG-BUSL-04
      name: 流程时序
      app: always
      detect: 多步骤流程可乱序执行或跳过前置步骤
      verify: 直接请求后续步骤 + 确认是否受理
      level: 确证可跳过校验步骤完成业务 → 高危
      compliance: 等保2.0 数据完整性

    - id: WSTG-BUSL-05
      name: 功能使用次数限制
      app: always
      detect: 优惠券 / 积分 / 抽奖 / 短信等无次数或频率限制
      verify: 受控重复提交（少量，避免造成业务影响）
      level: 确证可重复获利 → 高危
      compliance: 等保2.0 数据完整性

    - id: WSTG-BUSL-06
      name: 工作流绕过
      app: always
      detect: 审批 / 审核 / 状态机可被绕过
      verify: 直接调用终态接口 + 确认状态是否被接受
      level: 确证可绕过审批 → 严重
      compliance: 等保2.0 访问控制

    - id: WSTG-BUSL-07
      name: 应用滥用的防御
      app: always
      detect: 缺少反自动化措施（验证码 / 设备指纹 / 风控）
      verify: 观察是否存在人机校验与频率控制
      level: 完全缺失且业务可获利 → 中危
      compliance: ISO 27001 A.8.23

    - id: WSTG-BUSL-08
      name: 意外文件类型上传
      app: has_upload
      detect: 扩展名 / MIME / 内容校验缺失或可绕过
      verify: 受控上传带标记的测试文件 + 确认是否落地
      level: 确证可上传可执行类型 → 严重
      compliance: PCI-DSS 6.5.6 / 等保2.0 入侵防范

    - id: WSTG-BUSL-09
      name: 恶意文件上传
      app: has_upload
      detect: 上传后可被解析执行（同源 / 就近目录 / 解析漏洞）
      verify: 受控上传不可执行标记文件 + 确认访问行为（不投放 webshell）
      level: 确证可执行 → 严重
      compliance: PCI-DSS 6.5.6 / 等保2.0 入侵防范

    - id: WSTG-BUSL-10
      name: 支付功能
      app: has_payment
      detect: 金额 / 数量 / 币种 / 优惠可篡改，或订单可重放 / 并发重复
      verify: 受控测试（使用最小金额，事后按流程撤销）
      level: 确证可少付 / 重复获利 → 严重
      compliance: PCI-DSS 6.5.x / 等保2.0 数据完整性

# ==============================================================================
# 11 客户端  Client-side
# ==============================================================================
- category: CLNT
  name: 客户端
  wstg_dir: 11-Client-side
  items:
    - id: WSTG-CLNT-01
      name: 基于 DOM 的 XSS
      sub_items: [Self DOM-based XSS]
      app: has_client
      detect: 前端脚本将不可信来源写入 sink（innerHTML / eval / location）
      verify: 脚本构造 DOM 载荷 + 确认是否实际执行
      level: 确证可执行 → 高危；仅 sink 存在但不可控 → 中危
      compliance: PCI-DSS 6.5.2

    - id: WSTG-CLNT-02
      name: JavaScript 执行
      app: has_client
      detect: 用户输入进入 JS 执行上下文
      verify: 标记 payload + 确认执行结果
      level: 确证可执行 → 高危
      compliance: 等保2.0 入侵防范

    - id: WSTG-CLNT-03
      name: HTML 注入
      app: has_client
      detect: 输入可注入 HTML 结构（非脚本，但可钓鱼 / 界面伪装）
      verify: 注入标记结构 + 确认渲染
      level: 确证可注入并影响其他用户 → 中危
      compliance: 等保2.0 入侵防范

    - id: WSTG-CLNT-04
      name: 客户端 URL 重定向
      app: has_client
      detect: 跳转参数可指向任意外部域名
      verify: 确认 Location 是否真正跳转到外部域名
      level: 确证可跳转外站 → 低危（钓鱼辅助 → 中危）
      compliance: ISO 27001 A.8.26

    - id: WSTG-CLNT-05
      name: CSS 注入
      app: has_client
      detect: 用户可控 CSS，可通过属性选择器逐字符外带数据
      verify: 注入标记 CSS + 确认样式实际生效
      level: 确证可窃取页面敏感数据 → 高危；仅样式改写 → 低危
      compliance: ISO 27001 A.8.26

    - id: WSTG-CLNT-06
      name: 客户端资源操纵
      app: has_client
      detect: 从前端可操纵资源加载（脚本 / 图片 / 路径）
      verify: 手工确认可控范围与影响
      level: 确证可加载外部资源并执行 → 高危
      compliance: ISO 27001 A.8.26

    - id: WSTG-CLNT-07
      name: 跨域资源共享（CORS）
      app: has_api
      detect: Origin 反射 / 通配符 + 携带凭据
      verify: 构造带 Origin 的请求 + 确认 ACAO 与 ACAC 响应
      level: 确证可跨域读取敏感接口数据 → 高危；仅策略宽松 → 中危
      compliance: 等保2.0 边界访问控制 / ISO 27001 A.8.26

    - id: WSTG-CLNT-08
      name: 跨站 Flash（遗留）
      app: has_client
      detect: 存在 Flash 文件且允许跨域
      verify: 文件存在性确认
      level: 现代浏览器已停止支持 Flash，通常判 N/A
      compliance: —

    - id: WSTG-CLNT-09
      name: 点击劫持
      app: has_client
      detect: 缺 X-Frame-Options / CSP frame-ancestors
      verify: 构造 iframe 测试页 + 确认是否可嵌入
      level: 确证可嵌入且存在敏感操作 → 中危；仅可嵌入 → 低危
      compliance: ISO 27001 A.8.26

    - id: WSTG-CLNT-10
      name: WebSocket
      app: has_websocket
      detect: 握手不校验 Origin、消息无鉴权、明文 ws://
      verify: 跨站构造握手 + 无令牌发送消息确证
      level: 确证可越权收发消息 → 高危
      compliance: 等保2.0 访问控制

    - id: WSTG-CLNT-11
      name: Web 消息（postMessage）
      app: has_client
      detect: 未校验 event.origin 或使用通配符 targetOrigin
      verify: 构造跨域消息 + 确认是否被处理
      level: 确证可注入数据或触发敏感操作 → 高危
      compliance: ISO 27001 A.8.26

    - id: WSTG-CLNT-12
      name: 浏览器存储
      app: has_client
      detect: localStorage / sessionStorage / IndexedDB 存储敏感数据
      verify: 检查存储内容
      level: 存储凭据或 PII 且可被 XSS 读取 → 中危
      compliance: ISO 27001 A.8.24

    - id: WSTG-CLNT-13
      name: 跨站脚本包含（XSSI）
      app: has_api
      detect: 敏感 JSON 端点可被跨站脚本标签读取
      verify: 构造脚本标签引用 + 确认响应可解析
      level: 确证可读取敏感数据 → 中危
      compliance: ISO 27001 A.8.26

    - id: WSTG-CLNT-14
      name: 反向标签劫持
      app: has_client
      detect: 目标页含 target=_blank 且缺 rel=noopener
      verify: 检查外链属性
      level: 低危（仅跳转劫持，无数据泄露）
      compliance: ISO 27001 A.8.26

    - id: WSTG-CLNT-15
      name: 客户端模板注入
      app: has_client
      detect: 用户输入进入前端模板引擎并被执行
      verify: 注入模板表达式 + 确认求值结果
      level: 确证可执行表达式 → 高危；可读取敏感模板变量 → 中危
      compliance: 等保2.0 入侵防范

# ==============================================================================
# 12 API 测试  API Testing
# ==============================================================================
- category: APIT
  name: API 测试
  wstg_dir: 12-API_Testing
  items:
    - id: WSTG-APIT-01
      name: API 侦察
      app: has_api
      detect: 从 JS / SourceMap / 文档端点提取全部 API 路由与参数
      verify: 脚本提取 + 逐端点可达性确认（含伪路径对照）
      level: 清单型；其中无鉴权且可调用者单独定级
      compliance: ISO 27001 A.8.25

    - id: WSTG-APIT-02
      name: API 对象级授权缺陷（BOLA）
      app: has_api
      detect: 端点以对象 ID 索引且不校验归属
      verify: 多账号矩阵 + 资源 ID 交叉访问确证
      level: 实测取到他人有效数据 → 高危；返回空 → 低危
      compliance: OWASP API1 / PCI-DSS 6.5.3

    - id: WSTG-APIT-03
      name: 过度数据暴露
      app: has_api
      detect: 接口返回超出业务需要的大量字段（含内部字段与 PII）
      verify: 解析响应字段 + 比对业务必要性
      level: 返回未展示的敏感字段（手机号 / 身份证 / 内部标识） → 中危
      compliance: 等保2.0 数据保密性 / PIPL

    - id: WSTG-APIT-04
      name: API 功能级授权缺陷（BFLA）
      app: has_api
      detect: 管理级功能端点仅靠前端隐藏，后端不校验角色
      verify: 低权账号直接请求管理端点 + 确证实际操作结果
      level: 确证可执行管理操作 → 严重
      compliance: OWASP API5 / 等保2.0 访问控制

    - id: WSTG-APIT-99
      name: GraphQL 测试
      app: has_graphql
      detect: 内省开启、查询深度 / 复杂度无限制、字段级鉴权缺失、批量查询
      verify: 内省查询 + 深度嵌套 + 字段越权确证
      level: 确证可越权读取数据 / 拖库 → 高危；仅内省开启 → 中危
      compliance: OWASP API / 等保2.0 访问控制

# ==============================================================================
# 13 WebAssembly 测试
# ==============================================================================
- category: WASM
  name: WebAssembly 测试
  wstg_dir: 13-WebAssembly_Testing
  note: 该分类已在 WSTG 建立，但官方尚未发布具体测试项
  items:
    - id: WSTG-WASM-00
      name: WebAssembly 测试（基线未发布）
      app: always
      detect: 确认目标是否加载 .wasm 模块
      verify: 检查静态资源中的 wasm 文件
      level: 若存在 wasm 模块，报告中标注「基线未发布，建议人工评估」
      compliance: —

